# Git
.git
.gitignore

# Python
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache

# R
.Rhistory
.RData
.Rproj.user
renv/library
renv/staging

# Data (will be mounted as volume)
data/raw/*
data/processed/*
data/results/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/results/.gitkeep

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary
*.tmp
*.temp
*.log
